<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared size tokens. Android TV screens are 960×540 dp, so 1 dp = 4/3 px of the 1280×720 design
  canvas: dp value = design px × 0.75 (e.g. the canvas' 72 px side margin = 54 dp).
  Screen-specific sizes live in each layout file. See docs/UI.md.
-->
<resources>
    <!-- Screen frame (keeps content inside the TV safe area) -->
    <dimen name="screen_pad_h">54dp</dimen>
    <dimen name="screen_pad_top">30dp</dimen>
    <dimen name="screen_pad_bottom">21dp</dimen>

    <!-- Corner radii -->
    <dimen name="radius_s">4.5dp</dimen>
    <dimen name="radius_m">10.5dp</dimen>
    <dimen name="radius_l">13.5dp</dimen>
    <dimen name="radius_xl">18dp</dimen>

    <!-- Outlines -->
    <dimen name="stroke_hair">1dp</dimen>
    <dimen name="stroke_focus">3dp</dimen>

    <!-- Icons -->
    <dimen name="icon_s">15dp</dimen>
    <dimen name="icon_m">16.5dp</dimen>
    <dimen name="icon_l">18dp</dimen>

    <!-- Text sizes -->
    <dimen name="text_xs">11.25sp</dimen>
    <dimen name="text_s">12sp</dimen>
    <dimen name="text_m">13.5sp</dimen>
    <dimen name="text_body">15sp</dimen>
    <dimen name="text_l">16.5sp</dimen>
    <dimen name="text_xl">19.5sp</dimen>
    <dimen name="text_title">22.5sp</dimen>

    <!-- Key hint chips ("OK  Open") -->
    <dimen name="hint_spacing">27dp</dimen>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- One setting: label + explanation on the left, current value on the right. OK changes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="46.5dp"
    android:layout_marginTop="4.5dp"
    android:background="@drawable/bg_setting_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="21dp"
    android:paddingEnd="21dp">

    <!-- duplicateParentState passes the row's focus down to the two texts inside -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/label"
            style="@style/BB.Text.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:textColor="@color/on_focus_text"
            android:textSize="15.75sp" />

        <TextView
            android:id="@+id/hint"
            style="@style/BB.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:duplicateParentState="true"
            android:textColor="@color/on_focus_hint"
            android:textSize="@dimen/text_xs" />
    </LinearLayout>

    <TextView
        android:id="@+id/value"
        style="@style/BB.Text.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:textColor="@color/on_focus_value" />
</LinearLayout>

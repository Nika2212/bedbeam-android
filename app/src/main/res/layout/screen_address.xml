<?xml version="1.0" encoding="utf-8"?>
<!-- Address entry (design artboard "Typing an address"). Suggestions come from item_suggestion. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_pad_h"
        android:paddingTop="@dimen/screen_pad_top"
        android:paddingEnd="@dimen/screen_pad_h">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:background="@drawable/bg_address_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="21dp"
            android:paddingEnd="21dp">

            <ImageView
                android:layout_width="@dimen/icon_l"
                android:layout_height="@dimen/icon_l"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                android:tint="@color/on_light_muted" />

            <EditText
                android:id="@+id/address_input"
                style="@style/BB.Text.Medium"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionGo|flagNoExtractUi|flagNoFullscreen"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/bg"
                android:textColorHint="@color/on_light_muted"
                android:textSize="@dimen/text_l" />

            <TextView
                style="@style/BB.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enter_go"
                android:textColor="@color/on_light_muted"
                android:textSize="@dimen/text_s" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="vertical" />
    </LinearLayout>
</merge>

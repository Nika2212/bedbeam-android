<?xml version="1.0" encoding="utf-8"?>
<!-- The last tile: add a bookmark (dashed outline). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="199.5dp"
    android:layout_height="111dp"
    android:layout_marginEnd="18dp"
    android:layout_marginBottom="18dp"
    android:background="@drawable/bg_add_tile"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:stateListAnimator="@animator/focus_grow">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_plus"
        android:tint="@color/on_focus_icon" />

    <TextView
        style="@style/BB.Text.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.5dp"
        android:duplicateParentState="true"
        android:text="@string/add_bookmark"
        android:textColor="@color/on_focus_muted" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Start screen (design artboard "Start screen"). Bookmark tiles and key hints are added in code
     from item_bookmark_tile / item_add_tile / item_key_hint. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_pad_h"
        android:paddingTop="@dimen/screen_pad_top"
        android:paddingEnd="@dimen/screen_pad_h"
        android:paddingBottom="@dimen/screen_pad_bottom">

        <!-- Header: logo, name, settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_tile" />

            <TextView
                style="@style/BB.Text.Brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:text="@string/app_name" />

            <ImageView
                android:id="@+id/settings_button"
                android:layout_width="39dp"
                android:layout_height="39dp"
                android:background="@drawable/bg_icon_button"
                android:clickable="true"
                android:contentDescription="@string/settings"
                android:focusable="true"
                android:padding="10.5dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings"
                android:stateListAnimator="@animator/focus_grow_button"
                android:tint="@color/on_focus_icon" />
        </LinearLayout>

        <!-- Search pill: opens the address screen -->
        <LinearLayout
            android:id="@+id/search_pill"
            android:layout_width="585dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_search_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="21dp"
            android:paddingEnd="21dp"
            android:stateListAnimator="@animator/focus_grow_small">

            <ImageView
                android:layout_width="@dimen/icon_l"
                android:layout_height="@dimen/icon_l"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                android:tint="@color/on_focus_icon_soft" />

            <TextView
                style="@style/BB.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:duplicateParentState="true"
                android:text="@string/search_hint"
                android:textColor="@color/on_focus_muted"
                android:textSize="15.75sp" />
        </LinearLayout>

        <TextView
            style="@style/BB.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/bookmarks_title" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <GridLayout
                android:id="@+id/bookmark_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:columnCount="4"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/hints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center"
            android:orientation="horizontal" />
    </LinearLayout>
</merge>

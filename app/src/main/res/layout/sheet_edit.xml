<?xml version="1.0" encoding="utf-8"?>
<!-- Centered form for adding / renaming a bookmark. Fields come from item_edit_field.
     Sits near the top so the on-screen keyboard doesn't cover it. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true">

        <LinearLayout
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_edit_panel"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="27dp"
            android:paddingEnd="30dp"
            android:paddingBottom="27dp">

            <TextView
                android:id="@+id/title"
                style="@style/BB.Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_xl" />

            <LinearLayout
                android:id="@+id/fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/save"
                style="@style/BB.Text.Medium"
                android:layout_width="135dp"
                android:layout_height="42dp"
                android:layout_gravity="end"
                android:layout_marginTop="21dp"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:stateListAnimator="@animator/focus_grow_small"
                android:text="@string/save"
                android:textColor="@color/bg" />
        </LinearLayout>
    </FrameLayout>
</merge>

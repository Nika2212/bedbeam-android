<?xml version="1.0" encoding="utf-8"?>
<!-- Focused element grows slightly (design house style). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><set><objectAnimator android:propertyName="scaleX" android:duration="120" android:valueTo="1.07" android:valueType="floatType" /><objectAnimator android:propertyName="scaleY" android:duration="120" android:valueTo="1.07" android:valueType="floatType" /></set></item>
    <item><set><objectAnimator android:propertyName="scaleX" android:duration="120" android:valueTo="1" android:valueType="floatType" /><objectAnimator android:propertyName="scaleY" android:duration="120" android:valueTo="1" android:valueType="floatType" /></set></item>
</selector>

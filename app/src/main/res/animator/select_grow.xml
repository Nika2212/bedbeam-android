<?xml version="1.0" encoding="utf-8"?>
<!-- Focused element grows slightly (design house style). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"><set><objectAnimator android:propertyName="scaleX" android:duration="100" android:valueTo="1.08" android:valueType="floatType" /><objectAnimator android:propertyName="scaleY" android:duration="100" android:valueTo="1.08" android:valueType="floatType" /></set></item>
    <item><set><objectAnimator android:propertyName="scaleX" android:duration="100" android:valueTo="1" android:valueType="floatType" /><objectAnimator android:propertyName="scaleY" android:duration="100" android:valueTo="1" android:valueType="floatType" /></set></item>
</selector>
